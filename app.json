{
  "expo": {
    "name": "Metabolic Score",
    "slug": "metabolic-score",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "metabolicscore",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amitbaruna.metabolicscore",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.amitbaruna.metabolicscore"
    },
    "plugins": [
      "expo-notifications",
      "react-native-health",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "metabolic-score"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d2a7deb6-603c-4933-afbb-036644ba4ecd"
      }
    }
  }
}
