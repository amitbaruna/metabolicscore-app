{
  "expo": {
    "name": "Metabolic Score",
    "slug": "metabolic-score",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "metabolicscore",
    "newArchEnabled": false,
    "icon": "./src/assets/icon/appicon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amitbaruna.metabolicscore",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Metabolic Score lets you save your branded score card image to your photos when you choose to share or download it."
      }
    },
    "android": {
      "package": "com.amitbaruna.metabolicscore"
    },
    "plugins": [
      "expo-notifications",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "metabolic-score"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d2a7deb6-603c-4933-afbb-036644ba4ecd"
      }
    }
  }
}
